# =====================================================================
# Copie este arquivo para backend/.env e preencha os valores.
# O .env está no .gitignore: NUNCA commite senhas.
# =====================================================================

# --- Banco de dados (Supabase) ---
# Onde achar: painel do Supabase → botão "Connect" (topo) → Type: JDBC → Method: Session pooler.
# Copie a URL ATÉ "/postgres" (sem "?user=...&password=...") e acrescente "?sslmode=require".
# Use o Session pooler (IPv4). A conexão "Direct" (db.<ref>.supabase.co) só tem IPv6 e costuma falhar.
# Exemplo: jdbc:postgresql://aws-0-us-east-2.pooler.supabase.com:5432/postgres?sslmode=require
# Se der "tenant/user not found", troque aws-0 por aws-1 (ou vice-versa).
DB_URL=

# Usuário do pooler: "postgres." + ref do projeto. Exemplo: postgres.gnyiawtbkonedpthknku
DB_USER=

# Senha do banco definida ao criar o projeto.
# Esqueceu? Project Settings → Database → Reset database password.
DB_PASSWORD=

# --- JWT ---
# Qualquer texto aleatório com PELO MENOS 32 caracteres (usado para assinar os tokens).
JWT_SECRET=

# --- Opcionais ---
# Validade do token em milissegundos (padrão: 24 h).
# JWT_EXPIRACAO_MS=86400000
# Origens liberadas no CORS, separadas por vírgula (padrão: http://localhost:5173).
# CORS_ORIGENS=http://localhost:5173
